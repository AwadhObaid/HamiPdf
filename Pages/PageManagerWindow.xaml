<Window Icon="/HamiPdf;component/Assets/HamiPdf.ico" x:Class="HamiPdf.Pages.PageManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="إدارة الصفحات — الحامي PDF" Width="1180" Height="780" MinWidth="880" MinHeight="580"
 Background="#F2F5FA" FontFamily="Segoe UI" FontSize="13" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
 Loaded="Manager_Loaded" Closing="Manager_Closing" Closed="Manager_Closed">
 <Grid x:Name="RootPanel">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" Padding="6,3">
   <WrapPanel x:Name="ToolsPanel">
    <Button Content="إضافة ملفات" Tag="{StaticResource IconOpen}" Style="{StaticResource WorkspaceTool}" Click="Import_Click" ToolTip="إلحاق صفحات ملفات PDF في نهاية القائمة"/>
    <Button x:Name="UpButton" Content="لأعلى" Tag="{StaticResource IconUp}" Style="{StaticResource WorkspaceTool}" Click="Up_Click" ToolTip="تقديم الصفحات المحددة خطوة"/>
    <Button x:Name="DownButton" Content="لأسفل" Tag="{StaticResource IconDown}" Style="{StaticResource WorkspaceTool}" Click="Down_Click" ToolTip="تأخير الصفحات المحددة خطوة"/>
    <Button x:Name="RotateButton" Content="تدوير" Tag="{StaticResource IconRotate}" Style="{StaticResource WorkspaceTool}" Click="Rotate_Click" ToolTip="تدوير المحدد 90 درجة مع عقارب الساعة"/>
    <Button x:Name="DeleteButton" Content="حذف" Tag="{StaticResource IconDelete}" Style="{StaticResource WorkspaceTool}" Click="Delete_Click" ToolTip="حذف الصفحات المحددة من النسخة الجديدة"/>
    <Button x:Name="UndoButton" Content="تراجع" Tag="{StaticResource IconUndo}" Style="{StaticResource WorkspaceTool}" Click="Undo_Click"/>
    <Button x:Name="RedoButton" Content="إعادة" Tag="{StaticResource IconRedo}" Style="{StaticResource WorkspaceTool}" Click="Redo_Click"/>
    <Button x:Name="ExtractButton" Content="استخراج المحدد" Tag="{StaticResource IconExtract}" Style="{StaticResource WorkspaceTool}" Click="Extract_Click" ToolTip="حفظ المحدد فقط حسب ترتيبه الحالي في ملف جديد"/>
    <Button x:Name="SaveButton" Content="حفظ الكل" Tag="{StaticResource IconSave}" Style="{StaticResource WorkspaceTool}" Click="Save_Click" Background="#DDF3F0"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="1" Margin="6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="350" MinWidth="290"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="220"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="حدد أكثر من صفحة باستخدام Ctrl أو Shift" Foreground="#526477" Margin="4,0,0,5"/>
    <ListView x:Name="PageList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="PageList_SelectionChanged" BorderBrush="#D8E2E9" ScrollViewer.HorizontalScrollBarVisibility="Auto">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="4,6"/><Setter Property="ToolTip" Value="{Binding SourceName}"/></Style></ListView.ItemContainerStyle>
     <ListView.View><GridView>
      <GridViewColumn Header="الترتيب" Width="48" DisplayMemberBinding="{Binding Order}"/>
      <GridViewColumn Header="الملف" Width="155" DisplayMemberBinding="{Binding SourceName}"/>
      <GridViewColumn Header="الأصلية" Width="54" DisplayMemberBinding="{Binding OriginalPage}"/>
      <GridViewColumn Header="تدوير إضافي" Width="68" DisplayMemberBinding="{Binding RotationLabel}"/>
     </GridView></ListView.View>
    </ListView>
   </Grid>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DAE4EB" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="2" Background="#DDE5ED" CornerRadius="4" Padding="8">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="PreviewLabel" Text="معاينة الصفحة المحددة" Foreground="#526477" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
     <Viewbox Grid.Row="1" Stretch="Uniform" FlowDirection="LeftToRight">
      <Image x:Name="PreviewImage"><Image.LayoutTransform><RotateTransform x:Name="PreviewRotation"/></Image.LayoutTransform></Image>
     </Viewbox>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="White" Padding="10,3"><TextBlock x:Name="StatusLabel" Text="أضف ملفات PDF للبدء" Foreground="#526477" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
 </Grid>
</Window>
